app MelodyPlayer initial state off {
    bricks
        Actuator buzzer : 12
        Sensor button1 : 9
        Sensor button2 : 10

    states

        off {
            buzzer <= LOW
            button1 is HIGH => chorus
            button2 is HIGH => verse
        }

        chorus {
            buzzer <= NOTE(C4, 4)
            buzzer <= NOTE(C4, 4)
            buzzer <= NOTE(C4, 4)
            buzzer <= NOTE(D4, 4)
            buzzer <= NOTE(E4, 2)
            buzzer <= NOTE(D4, 2)
            buzzer <= NOTE(C4, 4)
            buzzer <= NOTE(E4, 4)
            buzzer <= NOTE(D4, 4)
            buzzer <= NOTE(D4, 4)
            buzzer <= NOTE(C4, 2)

            button1 is LOW or button1 is HIGH => off
        }

        verse {
            buzzer <= NOTE(D4, 4)
            buzzer <= NOTE(D4, 4)
            buzzer <= NOTE(D4, 4)
            buzzer <= NOTE(D4, 4)
            buzzer <= NOTE(A3, 2)
            buzzer <= NOTE(A3, 2)
            buzzer <= NOTE(D4, 4)
            buzzer <= NOTE(C4, 4)
            buzzer <= NOTE(B3, 4)
            buzzer <= NOTE(A3, 4)
            buzzer <= NOTE(G3, 2)
            
            button2 is LOW or button2 is HIGH => off
        }
}