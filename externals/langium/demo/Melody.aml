app MelodyPlayer initial state off {
    bricks
        Actuator led : 10
        Actuator buzzer : 11
        Sensor button1 : 8
        Sensor button2 : 9

    states

        off {
            led <= LOW
            buzzer <= LOW
            button1 is HIGH => chorus
            button2 is HIGH => verse
        }

        chorus {
            led <= HIGH

            button1 is HIGH and button2 is LOW => chorus
            button1 is LOW and button2 is HIGH => verse
            button1 is HIGH and button2 is HIGH => off
            button1 is LOW and button2 is LOW => off
        }

        verse {
            buzzer <= HIGH

            button1 is HIGH => chorus
            button2 is HIGH => verse
        }
}